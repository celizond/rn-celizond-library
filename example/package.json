{
  "name": "react-native-ui-library-example",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:ios": "xcodebuild ONLY_ACTIVE_ARCH=YES -workspace ios/UiLibraryExample.xcworkspace -UseNewBuildSystem=YES -scheme UiLibraryExample -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build -quiet",
    "build:android": "cd android && ./gradlew assembleDebug -DtestBuildType=debug -Dorg.gradle.jvmargs=-Xmx4g",
    "build:web": "expo export --platform web",
    "storybook": "cross-env STORYBOOK_ENABLED=true expo start",
    "storybook:clean": "cross-env STORYBOOK_ENABLED=true expo start --clear",
    "storybook:ios": "cross-env STORYBOOK_ENABLED=true expo start --ios",
    "storybook:android": "cross-env STORYBOOK_ENABLED=true expo start --android",
    "storybook:web": "cross-env STORYBOOK_ENABLED=true expo start --web",
    "storybook:web:clean": "cross-env STORYBOOK_ENABLED=true expo start --web --clear"
  },
  "dependencies": {
    "expo": "^54.0.31",
    "expo-status-bar": "~3.0.8",
    "fbjs": "^3.0.4",
    "inline-style-prefixer": "^7.0.1",
    "postcss-value-parser": "^4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "~0.21.0",
    "styleq": "^0.1.3"
  },
  "private": true,
  "devDependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native-community/slider": "^5.0.1",
    "@storybook/addon-ondevice-actions": "10.4.2",
    "@storybook/addon-ondevice-controls": "10.4.2",
    "@storybook/react": "^10.4.2",
    "@storybook/react-native": "10.4.2",
    "@storybook/react-native-theming": "10.4.2",
    "@storybook/react-native-ui": "^10.4.2",
    "@storybook/react-native-ui-common": "^10.4.2",
    "@storybook/react-native-ui-lite": "10.4.2",
    "babel-preset-expo": "~54.0.9",
    "cross-env": "^10.1.0",
    "react-native-builder-bob": "^0.41.0",
    "react-native-gesture-handler": "2.28.0",
    "react-native-monorepo-config": "^0.4.0",
    "react-native-reanimated": "4.1.7",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "^15.12.1",
    "react-native-worklets": "0.5.1",
    "storybook": "10.4.2"
  }
}

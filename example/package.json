{
  "name": "react-native-ui-library-example",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:ios": "xcodebuild ONLY_ACTIVE_ARCH=YES -workspace ios/UiLibraryExample.xcworkspace -UseNewBuildSystem=YES -scheme UiLibraryExample -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build -quiet",
    "build:android": "cd android && ./gradlew assembleDebug -DtestBuildType=debug -Dorg.gradle.jvmargs=-Xmx4g",
    "build:web": "expo export --platform web",
    "storybook": "cross-env STORYBOOK_ENABLED=true expo start --clear",
    "storybook:ios": "cross-env STORYBOOK_ENABLED=true expo start --ios --clear",
    "storybook:android": "cross-env STORYBOOK_ENABLED=true expo start --android --clear",
    "storybook:web": "cross-env STORYBOOK_ENABLED=true expo start --web --clear"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "expo": "~55.0.28",
    "expo-status-bar": "~55.0.6",
    "fbjs": "^3.0.4",
    "inline-style-prefixer": "^7.0.1",
    "postcss-value-parser": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.83.10",
    "react-native-web": "~0.21.0",
    "styleq": "^0.1.3",
    "react-native-safe-area-context": "5.8.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/slider": "^5.2.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.3",
    "react-native-gesture-handler": "^3.1.0",
    "@gorhom/bottom-sheet": "^5.2.14",
    "react-native-svg": "^15.15.5",
    "cross-env": "^10.1.0",
    "@storybook/addon-ondevice-controls": "^10.5.4",
    "@storybook/addon-ondevice-actions": "^10.5.4",
    "@storybook/react-native": "^10.5.4",
    "@storybook/react-native-theming": "^10.5.4",
    "@storybook/react-native-ui-lite": "^10.5.4",
    "storybook": "^10.5.5"
  },
  "private": true,
  "devDependencies": {
    "babel-preset-expo": "~55.0.24",
    "react-native-builder-bob": "^0.41.0",
    "react-native-monorepo-config": "^0.4.0"
  }
}
